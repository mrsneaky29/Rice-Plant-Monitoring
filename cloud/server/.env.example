# Required: generated by `python cli.py hash-password`; never store the plain password here.
RICE_ADMIN_PASSWORD_HASH=pbkdf2_sha256$600000$replace_with_salt_hex$replace_with_digest_hex

# Keep data outside the code checkout and on persistent storage.
RICE_DATA_DIR=./data
RICE_DB_PATH=./data/rice-cloud.sqlite3

# Use the public HTTPS origin exactly when deployed behind a reverse proxy.
RICE_PUBLIC_ORIGIN=https://rice.example.com
RICE_COOKIE_SECURE=true
RICE_SESSION_SECONDS=43200

# Analysis remains off unless deliberately enabled. A real supported model ID,
# provider key, and up-to-date responses endpoint must be configured together.
RICE_ANALYSIS_ENABLED=false
RICE_OPENAI_API_KEY=
RICE_ANALYSIS_MODEL=gpt-6.1-sol
RICE_ANALYSIS_PASSES=1
RICE_ANALYSIS_POLL_SECONDS=20
RICE_OPENAI_RESPONSES_URL=https://api.openai.com/v1/responses
